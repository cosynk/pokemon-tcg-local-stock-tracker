# Pokémon TCG Local Stock Tracker — web/.env.example
# Copy to .env.local and fill in your own values. NEVER commit a filled file.
# See also ../.env.example (repo root) — same variables, placeholders only.

# --- Supabase (website + auth) ---
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase -> Project Settings -> API -> service_role (server only, never in the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase -> Project Settings -> Database -> Connection string (URI), optional
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Best Buy (live adapter, awaiting key) ---
# Free key from https://developer.bestbuy.com. Pending as of 2026-11-24.
# Until set, Best Buy stock shows as Unknown, never In stock.
BEST_BUY_API_KEY=
BBY_API_KEY=

# --- Shared backend (Discord bot -> website API) ---
# Long random shared secret you generate (openssl rand -hex 32).
TRACKER_API_KEY=

# --- Discord account linking (OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Google sign-in (configured in Supabase Auth providers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
