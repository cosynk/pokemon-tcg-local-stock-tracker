# Pokémon TCG Local Stock Tracker — .env.example
# Copy to .env (website) / .env (bot) and fill in your own values.
# NEVER commit a filled-in .env. No real keys, tokens, or secrets are in this repo.
# Placeholders only below.

# --- Best Buy (live adapter, awaiting key) ---
# Free key from https://developer.bestbuy.com — register, a company email may be
# required, key arrives/activates by email. Free tier: 5,000 calls/day, 5/sec.
# Chase's key request is PENDING as of 2026-11-24. Leave blank until it arrives,
# then paste the key via the secure link — do not paste it in chat.
# Until this is set, Best Buy stock shows as Unknown, never In stock.
BEST_BUY_API_KEY=
# Alias accepted by the Best Buy SDK:
BBY_API_KEY=

# --- Discord bot ---
# Discord Developer Portal -> your application -> Bot -> Reset Token.
# Never commit it. Set it only in your host's environment (Railway / Fly.io).
DISCORD_BOT_TOKEN=
# Discord Developer Portal -> OAuth2 -> General.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Google sign-in (standalone Next.js deployment only) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Authorized redirect: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (standalone deployment) ---
# Supabase -> Project Settings -> Database -> Connection string (URI).
# The Muse artifact uses its built-in database; this is only for the public deploy.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Shared backend (bot -> website API) ---
# The public URL of your deployed website, e.g. https://your-tracker.vercel.app
TRACKER_API_BASE=https://YOUR-DOMAIN
# A long random shared secret you generate yourself (e.g. openssl rand -hex 32).
# The website API checks `Authorization: Bearer <TRACKER_API_KEY>` on bot calls.
# It is NOT your Discord token and NOT your Best Buy key.
TRACKER_API_KEY=

# --- Optional ---
# NEXTAUTH_SECRET=  # generate with: openssl rand -base64 32 (NextAuth, if used)
# DISCORD_GUILD_ID=  # optional: limit slash-command sync to one test server
